{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@x-ac/web-design-react-antd": ["src/index.tsx"],
      // 类型检查统一指向兄弟仓的引擎源码（1.1.0，含 visibility）。
      // tests/example-schema.spec.tsx 会间接把 example/src/schema.ts 纳入本配置，
      // 若这里仍解析 node_modules 的 1.0.0 类型，示例里的新字段会被判为不存在。
      // 产物侧由 vite-plugin-dts 的 beforeWriteFile 改写回包名，verify-dist 会校验无本地路径残留。
      "@x-ac/web-design-react/designer": ["../project/packages/react/src/designer.ts"],
      "@x-ac/web-design-react/kit": ["../project/packages/react/src/kit.ts"],
      "@x-ac/web-design-react": ["../project/packages/react/src/index.ts"],
      "@x-ac/web-design-core": ["../project/packages/core/src/index.ts"],
      // React 本身不带 .d.ts，类型来自 @types/react；这里强制把本包与引擎依赖里的
      // `import type ... from "react"` 收敛到本仓单一副本，避免两份 @types/react 互不兼容。
      // （与 Vue 版不同：vue 包自带类型，可直指 node_modules/vue）
      "react": ["node_modules/@types/react"],
      "react-dom": ["node_modules/@types/react-dom"]
    },
    "types": ["vite/client", "node", "react", "react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "env.d.ts"]
}
